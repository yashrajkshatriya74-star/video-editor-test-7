<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Video Editor"
        android:theme="@style/Theme.VideoEditor"
        android:supportsRtl="true">

        <!-- TimelineActivity is the launcher now — the app opens straight into the
             single-screen editor (KineMaster-style) instead of a separate hub menu.
             MainActivity is kept around but no longer launches by default. -->
        <activity
            android:name=".timeline.TimelineActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".editor.EditorActivity" android:exported="false" />
        <activity android:name=".chroma.ChromaKeyActivity" android:exported="false" />
        <activity android:name=".model3d.Model3DActivity" android:exported="false" />

    </application>
</manifest>
